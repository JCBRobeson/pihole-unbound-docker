PIHOLE_PASSWORD=change-me
PIHOLE_APP_SUDO=false         # Allow app passwords to change settings/import data. Only set true on a replica that a sync tool (e.g. nebula-sync) writes to. Default: false
PIHOLE_DNSMASQ_LINES=address=/lab.home.arpa/192.0.2.10 # Optional: send every name under a subdomain to your reverse proxy.
LAN_SUBNET=192.0.2.0/24     # your LAN in CIDR notation
LAN_GATEWAY=192.0.2.1    # your router (DHCP server)
LAN_DOMAIN=lan                # local domain your router hands out
TZ=your-timezone              # your timezone
